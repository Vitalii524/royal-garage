        DEFAULT TRUE,

    sort_order INTEGER NOT NULL
        DEFAULT 0,

    created_at TIMESTAMPTZ NOT NULL
        DEFAULT NOW(),

    updated_at TIMESTAMPTZ NOT NULL
        DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS service_history_purchases (
    id UUID PRIMARY KEY,

    user_id UUID NOT NULL
        REFERENCES users(id)
