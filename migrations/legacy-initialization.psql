        transmission TEXT, fuel TEXT, plate TEXT, vin TEXT, year INTEGER, mileage INTEGER, engine TEXT, reason TEXT NOT NULL,
        status TEXT NOT NULL DEFAULT 'pending', crm_client_id UUID, crm_car_id UUID,
        created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(), confirmed_at TIMESTAMPTZ
    );

ALTER TABLE business_service_requests ADD COLUMN IF NOT EXISTS year INTEGER;

ALTER TABLE business_service_requests ADD COLUMN IF NOT EXISTS mileage INTEGER;

ALTER TABLE business_service_requests ADD COLUMN IF NOT EXISTS engine TEXT;

ALTER TABLE business_service_requests
