CREATE TABLE IF NOT EXISTS uploaded_videos (
 id UUID PRIMARY KEY, owner_id UUID NOT NULL REFERENCES users(id), mime_type TEXT NOT NULL,
 data BYTEA NOT NULL, name TEXT NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());

CREATE TABLE IF NOT EXISTS community_clubs (
 id UUID PRIMARY KEY, owner_id UUID NOT NULL REFERENCES users(id), name VARCHAR(80) NOT NULL,
 description VARCHAR(1000) NOT NULL DEFAULT '', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());

ALTER TABLE community_clubs ADD COLUMN IF NOT EXISTS deleted_at TIMESTAMPTZ;

ALTER TABLE community_clubs ADD COLUMN IF NOT EXISTS cover_image TEXT;

CREATE UNIQUE INDEX IF NOT EXISTS community_clubs_name ON community_clubs(lower(name));

CREATE TABLE IF NOT EXISTS community_club_members (
 club_id UUID NOT NULL REFERENCES community_clubs(id) ON DELETE CASCADE,
 user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
 PRIMARY KEY(club_id,user_id));

ALTER TABLE forum_notifications ADD COLUMN IF NOT EXISTS source VARCHAR(16) NOT NULL DEFAULT 'forum',
            ADD COLUMN IF NOT EXISTS url TEXT, ADD COLUMN IF NOT EXISTS event_key TEXT;

CREATE UNIQUE INDEX IF NOT EXISTS notification_event_unique ON forum_notifications(user_id,event_key);

CREATE TABLE IF NOT EXISTS notification_preferences (
            user_id UUID PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
            push_enabled BOOLEAN NOT NULL DEFAULT TRUE);

UPDATE forum_notifications SET source=CASE WHEN kind='club_follow' THEN 'clubs' WHEN kind='follow' THEN 'profile' ELSE 'forum' END,
            url=CASE WHEN topic_id IS NOT NULL THEN '/forum.html?topicId='||topic_id ELSE '/profile.html' END WHERE url IS NULL;

CREATE TABLE IF NOT EXISTS crm_media (
        id UUID PRIMARY KEY,owner_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,request_id UUID REFERENCES business_service_requests(id) ON DELETE SET NULL,
        work_order_id UUID REFERENCES crm_work_orders(id) ON DELETE CASCADE,mime_type TEXT NOT NULL,data BYTEA NOT NULL,caption TEXT NOT NULL DEFAULT '',created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());

CREATE TABLE IF NOT EXISTS service_catalog_images (
 id UUID PRIMARY KEY, owner_id UUID NOT NULL REFERENCES users(id), mime TEXT NOT NULL,
 original BYTEA NOT NULL, preview BYTEA NOT NULL, created_at TIMESTAMPTZ NOT NULL DEFAULT NOW());
