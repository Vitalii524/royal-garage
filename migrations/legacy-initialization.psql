ADD COLUMN IF NOT EXISTS watermark_version INTEGER NOT NULL DEFAULT 0;

ALTER TABLE market_listings
ADD COLUMN IF NOT EXISTS
    vehicle_type VARCHAR(30) NOT NULL DEFAULT 'car',
ADD COLUMN IF NOT EXISTS
    brand VARCHAR(100),
ADD COLUMN IF NOT EXISTS
    model VARCHAR(160);

CREATE INDEX IF NOT EXISTS
