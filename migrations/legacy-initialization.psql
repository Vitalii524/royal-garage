    id UUID PRIMARY KEY,

    user_id UUID NOT NULL
        REFERENCES users(id)
        ON DELETE CASCADE,

    listing_id UUID NOT NULL
        REFERENCES market_listings(id)
        ON DELETE CASCADE,

    order_id TEXT UNIQUE NOT NULL,

