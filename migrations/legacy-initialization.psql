ON market_listings (
    vehicle_type,
    brand,
    model
);

CREATE TABLE IF NOT EXISTS market_listing_views (
    listing_id UUID NOT NULL REFERENCES market_listings(id) ON DELETE CASCADE,
    viewer_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
